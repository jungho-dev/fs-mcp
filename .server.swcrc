/**
 * @file .server.swcrc
 * @description swc 설정 (서버)
 * @author Jungho
 * @since 2025-11-30
 * @updated 2026-05-02
 */
{
  "$schema": "https://swc.rs/schema.json",
  "isModule": "unknown",
  "minify": true,
  "sourceMaps": false,
  "inlineSourcesContent": false,
  "exclude": [
    ".*node_modules.*"
  ],
  "module": {
    "type": "es6",
    "strict": false,
    "strictMode": true,
    "lazy": false,
    "noInterop": false,
    "importInterop": "node",
    "ignoreDynamic": false,
    "preserveImportMeta": false,
    "resolveFully": false
  },
  "jsc": {
    "target": "esnext",
    "loose": true,
    "externalHelpers": true,
    "keepClassNames": true,
    "preserveAllComments": false,
    "baseUrl": ".",
    "paths": {
      "@cores/*": ["./src/cores/*.ts", "./src/cores/*"],
      "@assets/*": ["./src/assets/*.ts", "./src/assets/*"],
      "@controllers/*": ["./src/controllers/*.ts", "./src/controllers/*"],
      "@features/*": ["./src/features/*.ts", "./src/features/*"],
      "@cores/responses/*": ["./src/cores/responses/*.ts", "./src/cores/responses/*"],
      "@schemas/*": ["./src/schemas/*.ts", "./src/schemas/*"],
      "@tools/*": ["./src/tools/*.ts", "./src/tools/*"],
      "@type/*": ["./src/assets/type/*.ts", "./src/assets/type/*"]
    },
    "parser": {
      "syntax": "typescript",
      "tsx": false,
      "decorators": true,
      "dynamicImport": true
    },
    "minify": {
      "compress": {
        "computed_props": true,
        "conditionals": true,
        "comparisons": true,
        "dead_code": true,
        "defaults": true,
        "drop_console": false,
        "drop_debugger": true,
        "evaluate": true,
        "hoist_props": true,
        "if_return": true,
        "join_vars": true,
        "loops": true,
        "negate_iife": true,
        "properties": true,
        "reduce_vars": true,
        "side_effects": true,
        "switches": true,
        "typeofs": true,
        "unused": true
      },
      "mangle": {
        "keepClassNames": true,
        "keepFnNames": true
      },
      "format": {
        "comments": false,
        "asciiOnly": false
      }
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true,
      "useDefineForClassFields": false,
      "treatConstEnumAsEnum": false,
      "verbatimModuleSyntax": false
    },
    "output": {
      "charset": "utf8"
    }
  }
}
