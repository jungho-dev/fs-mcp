{
  "$schema": "https://www.schemastore.org/tsconfig",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./out",
    "paths": {
      "@app/*": ["./src/app/*.ts", "./src/app/*"],
      "@assets/*": ["./src/assets/*.ts", "./src/assets/*"],
      "@features/*": ["./src/features/*.ts", "./src/features/*"],
      "@mcp/*": ["./src/mcp/*.ts", "./src/mcp/*"],
      "@type/*": ["./src/assets/type/*.ts", "./src/assets/type/*"]
    },
    "typeRoots": ["./node_modules/@types", "./src/assets/type"],
    "types": ["bun", "node"],
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": false,
    "checkJs": false,
    "composite": false,
    "incremental": false,
    "pretty": true,
    "diagnostics": false,
    "sourceMap": false,
    "mapRoot": "",
    "sourceRoot": "",
    "plugins": [],
    "removeComments": true,
    "newLine": "lf",
    "assumeChangesOnlyAffectDirectDependencies": false,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "traceResolution": false,
    "extendedDiagnostics": false,
    "explainFiles": false,
    "exactOptionalPropertyTypes": false,
    "inlineSourceMap": false,
    "inlineSources": false,
    "isolatedDeclarations": false,
    "stripInternal": false,
    "maxNodeModuleJsDepth": 0,
    "listFiles": false,
    "listEmittedFiles": false,
    "declaration": false,
    "declarationMap": false,
    "esModuleInterop": true,
    "isolatedModules": false,
    "moduleDetection": "auto",
    "verbatimModuleSyntax": false,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "resolveJsonModule": true,
    "resolvePackageJsonExports": true,
    "resolvePackageJsonImports": true,
    "customConditions": [],
    "moduleSuffixes": [],
    "skipLibCheck": true,
    "skipDefaultLibCheck": false,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": false,
    "noEmit": false,
    "noEmitOnError": true,
    "noLib": false,
    "noResolve": false,
    "noImplicitOverride": true,
    "noImplicitUseStrict": false,
    "noEmitHelpers": false,
    "noErrorTruncation": true,
    "noUncheckedIndexedAccess": false,
    "noPropertyAccessFromIndexSignature": false,
    "noStrictGenericChecks": false,
    "disableReferencedProjectLoad": false,
    "disableSolutionSearching": false,
    "disableSourceOfProjectReferenceRedirect": false,
    "disableSizeLimit": true,
    "preserveSymlinks": true,
    "preserveConstEnums": false,
    "preserveWatchOutput": false,
    "preserveValueImports": false,
    "emitBOM": false,
    "emitDeclarationOnly": false,
    "emitDecoratorMetadata": true,
    "alwaysStrict": true,
    "allowImportingTsExtensions": false,
    "allowUmdGlobalAccess": true,
    "allowSyntheticDefaultImports": true,
    "allowArbitraryExtensions": true,
    "allowUnreachableCode": true,
    "allowUnusedLabels": true,
    "ignoreDeprecations": "6.0",
    "keyofStringsOnly": false,
    "suppressExcessPropertyErrors": false,
    "suppressImplicitAnyIndexErrors": false,
    "strict": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "strictBuiltinIteratorReturn": false,
    "useDefineForClassFields": true,
    "useUnknownInCatchVariables": true,
    "importHelpers": true,
    "importsNotUsedAsValues": "remove"
  },
  "include": ["./src/**/*"],
  "exclude": ["node_modules", "out", "dist", "tests", "**/*.spec.ts"]
}
